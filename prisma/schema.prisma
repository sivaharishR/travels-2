// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id             String   @id @default(cuid())
  bookingRef     String   @unique
  passengerName  String
  phone          String
  email          String?
  pickupLocation String
  dropLocation   String
  tripType       String   @default("ONE_WAY")
  cabType        String
  passengers     Int      @default(1)
  distanceKm     Float
  baseFare       Float
  perKmRate      Float
  distanceFare   Float
  totalFare      Float
  status         String   @default("CONFIRMED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  type       String
  message    String
  bookingRef String?
  createdAt  DateTime @default(now())
}

model EmailLog {
  id         String   @id @default(cuid())
  toAddress  String
  subject    String
  status     String
  error      String?
  bookingRef String?
  createdAt  DateTime @default(now())
}
